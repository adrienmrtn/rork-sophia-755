            },
            {
              "x": 0.55,
              "y": 0.33,
              "zoom": 1.6,
              "text": "**Three planes**, in formation, flying very low.",
              "outline": [
                {
                  "ellipse": [
                    0.335,
                    0.205,
                    0.075,
                    0.04
                  ]
                },
                {
                  "ellipse": [
