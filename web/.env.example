# Copier en .env.local pour le développement. Les variables NEXT_PUBLIC_* sont publiques (navigateur).

# Supabase de l'app Sophia (le même projet que iOS et Android)
NEXT_PUBLIC_SUPABASE_URL=https://afnmcoovdvbtkgohtdij.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eNzCyPFfEuKC0tKWr0Hjag_lJ_qsWRw

# Adresse publique du site (métadonnées, sitemap, redirections d'authentification)
NEXT_PUBLIC_SITE_URL=https://sophia-culture.com

# Serveur seulement, jamais dans le navigateur. À poser dans Vercel (Settings → Environment Variables).
# Clé service_role du projet Supabase : publication par l'équipe (copie de la photo, mise à jour du brouillon, jobs_dispatch).
SUPABASE_SERVICE_ROLE_KEY=
# La même clé que le secret PUBLISH_API_KEY de l'Edge Function publish-course.
PUBLISH_API_KEY=

# Facultatif
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6744889213
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.rork.sophia
# SOPHIA_DATA=starter   # lit les packs de départ de l'app au lieu de Supabase (captures hors ligne)
