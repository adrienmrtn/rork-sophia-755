<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deep links app Sophia + callback URL scheme Meta (fb + App ID). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.rork.sophia</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sophia</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb2056318204963651</string>
			</array>
		</dict>
	</array>
	<!-- Identifiant numérique de l'app Meta (lu automatiquement par FacebookCore). -->
	<key>FacebookAppID</key>
	<string>2056318204963651</string>
	<!-- Client token Meta — secret d'app, uniquement ici (pas dans le code Swift). -->
	<key>FacebookClientToken</key>
	<string>d5806d3f17a5fcabc6a31ea59bd08d99</string>
	<!-- Nom affiché côté Meta / Facebook. -->
	<key>FacebookDisplayName</key>
	<string>Sophia</string>
	<!-- Active l'envoi automatique d'App Events (install, lancement) — requis par Meta App Manager. -->
	<key>FacebookAutoLogAppEventsEnabled</key>
	<true/>
	<!-- Autorise la collecte IDFA quand l'utilisateur consent via ATT. -->
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<true/>
	<!-- Schémas requis pour que le SDK détecte / interagisse avec l'écosystème Facebook. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
	</array>
	<!-- Texte ATT affiché par iOS avant la demande de tracking publicitaire. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Sophia utilise cet identifiant pour mesurer l'efficacité de ses campagnes publicitaires et améliorer la pertinence des annonces.</string>
</dict>
</plist>
